diff --git a/src/modules/simulation/gz_bridge/GZBridge.cpp b/src/modules/simulation/gz_bridge/GZBridge.cpp
index 56c6d02..79492e6 100644
--- a/src/modules/simulation/gz_bridge/GZBridge.cpp
+++ b/src/modules/simulation/gz_bridge/GZBridge.cpp
@@ -735,6 +735,16 @@ void GZBridge::navSatCallback(const gz::msgs::NavSat &nav_sat)
 		global_position_groundtruth.lat = nav_sat.latitude_deg();
 		global_position_groundtruth.lon = nav_sat.longitude_deg();
 		global_position_groundtruth.alt = nav_sat.altitude();
+		if (_param_flat_alt.get() && _timestamp_prev > 0) {
+			// A local Cartesian world has no ellipsoid curvature in its physics.
+			// Anchor once to NavSat, then follow world Z. Preserve spawn altitude.
+			if (!_flat_alt_initialized) {
+				_flat_alt_offset = nav_sat.altitude() + _position_prev(2);
+				_flat_alt_initialized = true;
+			}
+			global_position_groundtruth.alt = _flat_alt_offset - _position_prev(2);
+		}
+		global_position_groundtruth.timestamp = hrt_absolute_time();
 		_gpos_ground_truth_pub.publish(global_position_groundtruth);
 	}
 
