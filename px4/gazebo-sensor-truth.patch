diff --git a/src/modules/simulation/gz_bridge/parameters.c b/src/modules/simulation/gz_bridge/parameters.c
index 8dd6022..8b35a27 100644
--- a/src/modules/simulation/gz_bridge/parameters.c
+++ b/src/modules/simulation/gz_bridge/parameters.c
@@ -40,3 +40,16 @@
  */
 PARAM_DEFINE_INT32(SIM_GZ_EN, 0);
 
+
+/**
+ * Use Cartesian world height for Gazebo GPS altitude
+ *
+ * Enable for flat local maps. GPS altitude is anchored at the first pose
+ * and follows world Z, avoiding artificial ellipsoid curvature with range.
+ * Disable for simulations intentionally using the spherical NavSat altitude.
+ *
+ * @boolean
+ * @reboot_required true
+ * @group Simulator
+ */
+PARAM_DEFINE_INT32(SIM_GZ_FLAT_ALT, 0);
