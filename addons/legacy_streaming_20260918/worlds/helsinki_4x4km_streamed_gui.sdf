<?xml version="1.0" encoding="UTF-8"?>
<!-- GUI-only world: no vehicle or sensor renderer. -->
<sdf version="1.9">
  <world name="helsinki_4x4km_streamed_gui">
    <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system"/>
    <plugin name="gz::sim::systems::UserCommands" filename="gz-sim-user-commands-system"/>
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system"/>
    <plugin name="gz::sim::systems::Contact" filename="gz-sim-contact-system"/>
    <plugin name="gz::sim::systems::ApplyLinkWrench" filename="gz-sim-apply-link-wrench-system"/>
    <physics type="dart">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
      <dart><collision_detector>bullet</collision_detector></dart>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <scene>
      <grid>false</grid>
      <ambient>0.85 0.85 0.85 1</ambient>
      <background>0.32 0.36 0.40 1</background>
      <shadows>false</shadows>
    </scene>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>60.1699</latitude_deg>
      <longitude_deg>24.9384</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>

    <!-- Collision-enabled landing surface at the surveyed takeoff position. -->
    <include>
      <uri>model://aruco_landing_pad</uri>
      <name>aruco_landing_pad</name>
      <pose>48.700802 -71.058502 25.872900 0 0 0</pose>
    </include>

    <gui fullscreen="0">
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui><title>Helsinki3D 4 x 4 km streamed GUI</title></gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.85 0.85 0.85 1</ambient_light>
        <background_color>0.32 0.36 0.40 1</background_color>
        <camera_pose>-100 -100 120 0 0.42 0</camera_pose>
        <camera_clip><near>0.2</near><far>2000</far></camera_clip>
        <horizontal_fov>80</horizontal_fov>
        <anti_aliasing>0</anti_aliasing>
        <view_controller>orbit</view_controller>
      </plugin>
      <!-- Plugin order follows Gazebo's MinimalScene configuration. -->
      <plugin filename="EntityContextMenuPlugin" name="Entity context menu">
        <gz-gui>
          <property key="state" type="string">floating</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="GzSceneManager" name="Scene Manager">
        <gz-gui>
          <property key="state" type="string">floating</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="HelsinkiGuiPosePublisher" name="helsinki_stream::GuiPosePublisher">
        <topic>/helsinki_stream/gui_pose</topic>
        <tracking_gain>0.1</tracking_gain>
      </plugin>
      <!-- MinimalScene receives orbit / pan / zoom input through this plugin. -->
      <plugin filename="InteractiveViewControl" name="Interactive view control">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <!-- Lets Entity tree's Move to / Follow actions drive the GUI camera. -->
      <plugin filename="CameraTracking" name="Camera Tracking">
        <follow_pgain>0.1</follow_pgain>
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <!-- Keep the entity tree visible for Move To and Follow actions. -->
      <plugin filename="EntityTree" name="Entity tree">
        <gz-gui>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
      </plugin>
    </gui>
  </world>
</sdf>
