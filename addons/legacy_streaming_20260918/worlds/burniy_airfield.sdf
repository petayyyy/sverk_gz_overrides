<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.9">
  <world name="burniy_airfield">
    <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system" />
    <plugin name="gz::sim::systems::UserCommands" filename="gz-sim-user-commands-system" />
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system" />
    <plugin name="gz::sim::systems::Contact" filename="gz-sim-contact-system" />
    <plugin name="gz::sim::systems::Imu" filename="gz-sim-imu-system" />
    <plugin name="gz::sim::systems::AirPressure" filename="gz-sim-air-pressure-system" />
    <plugin name="gz::sim::systems::Magnetometer" filename="gz-sim-magnetometer-system" />
    <plugin name="gz::sim::systems::ApplyLinkWrench" filename="gz-sim-apply-link-wrench-system" />
    <plugin name="gz::sim::systems::NavSat" filename="gz-sim-navsat-system" />
    <plugin name="gz::sim::systems::Sensors" filename="gz-sim-sensors-system">
      <render_engine>ogre2</render_engine>
    </plugin>
    <physics type="dart">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
      <dart>
        <collision_detector>bullet</collision_detector>
      </dart>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic" />
    <scene>
      <grid>false</grid>
      <ambient>0.85 0.85 0.85 1</ambient>
      <background>0.32 0.36 0.40 1</background>
      <shadows>false</shadows>
    </scene>
    <include>
      <uri>model://burniy_airfield_chunked</uri>
      <name>burniy_airfield_chunked</name>
    </include>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>60.612638885</latitude_deg>
      <longitude_deg>30.469444445</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>
    <gui fullscreen="0">
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui>
          <title>Burniy airfield — Ogre2 full map</title>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.85 0.85 0.85 1</ambient_light>
        <background_color>0.32 0.36 0.40 1</background_color>
        <camera_pose>52.718 -412.481 65 0 0.75 0</camera_pose>
        <camera_clip>
          <near>0.2</near>
          <far>2000</far>
        </camera_clip>
        <horizontal_fov>80</horizontal_fov>
        <anti_aliasing>0</anti_aliasing>
        <view_controller>orbit</view_controller>
      </plugin>
      <plugin filename="GzSceneManager" name="Scene Manager">
        <gz-gui>
          <property key="state" type="string">floating</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
    </gui>
    <include>
      <uri>model://burniy_airfield_collision</uri>
    </include>
    <include>
      <uri>model://burniy_landing_pad</uri>
      <!-- OSM node -28154: object=drone. The pad base starts 4 cm above
           the flat terrain collision so its textured top cannot z-fight. -->
      <pose>105.718 -412.481 0.04 0 0 0</pose>
    </include>
  </world>
</sdf>
