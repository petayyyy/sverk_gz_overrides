<?xml version="1.0" encoding="UTF-8"?>
<!--
  Streamed Helsinki mission world. Map tiles are intentionally absent here:
  tile_streamer.py creates/removes individual visual-only tile models at run
  time. The Sensors system remains enabled for vehicle cameras and lidars.
-->
<sdf version="1.9">
  <world name="helsinki_4x4km_streamed">
    <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system"/>
    <plugin name="gz::sim::systems::UserCommands" filename="gz-sim-user-commands-system"/>
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system"/>
    <plugin name="gz::sim::systems::Contact" filename="gz-sim-contact-system"/>
    <plugin name="gz::sim::systems::Imu" filename="gz-sim-imu-system"/>
    <plugin name="gz::sim::systems::AirPressure" filename="gz-sim-air-pressure-system"/>
    <plugin name="gz::sim::systems::Magnetometer" filename="gz-sim-magnetometer-system"/>
    <plugin name="gz::sim::systems::ApplyLinkWrench" filename="gz-sim-apply-link-wrench-system"/>
    <plugin name="gz::sim::systems::NavSat" filename="gz-sim-navsat-system"/>
    <plugin name="gz::sim::systems::Sensors" filename="gz-sim-sensors-system">
      <render_engine>ogre2</render_engine>
    </plugin>

    <physics type="dart">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
      <dart><collision_detector>bullet</collision_detector></dart>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <scene>
      <grid>false</grid>
      <ambient>0.85 0.85 0.85 1</ambient>
      <background>0.32 0.36 0.40 1</background>
      <shadows>false</shadows>
    </scene>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>60.1699</latitude_deg>
      <longitude_deg>24.9384</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>

    <!-- Surveyed takeoff position with a collision-enabled landing surface. -->
    <include>
      <uri>model://aruco_landing_pad</uri>
      <name>aruco_landing_pad</name>
      <pose>48.700802 -71.058502 25.872900 0 0 0</pose>
    </include>

    <gui fullscreen="0">
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui><title>Helsinki3D 4 x 4 km streamed Ogre2</title></gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.85 0.85 0.85 1</ambient_light>
        <background_color>0.32 0.36 0.40 1</background_color>
        <!-- Initial view of the landing pad and vehicle. -->
        <camera_pose>0 -71.058502 80 0 0.70 0</camera_pose>
        <camera_clip><near>0.2</near><far>2000</far></camera_clip>
        <horizontal_fov>80</horizontal_fov>
        <anti_aliasing>0</anti_aliasing>
        <view_controller>orbit</view_controller>
      </plugin>
      <!-- Supplies the right-click actions used by Entity Tree. -->
      <plugin filename="EntityContextMenuPlugin" name="Entity context menu">
        <gz-gui>
          <property key="state" type="string">floating</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="HelsinkiGuiPosePublisher" name="helsinki_stream::GuiPosePublisher">
        <topic>/helsinki_stream/gui_pose</topic>
        <tracking_gain>0.1</tracking_gain>
      </plugin>
      <!-- MinimalScene receives orbit / pan / zoom input through this plugin. -->
      <plugin filename="InteractiveViewControl" name="Interactive view control">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="GzSceneManager" name="Scene Manager">
        <gz-gui>
          <property key="state" type="string">floating</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <!-- Enables Entity Tree's Move to and Follow camera commands. -->
      <plugin filename="CameraTracking" name="Camera Tracking">
        <follow_pgain>0.1</follow_pgain>
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="EntityTree" name="Entity tree">
        <gz-gui>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
      </plugin>
    </gui>
  </world>
</sdf>
