<?xml version="1.0"?>
<package format="3">
  <name>porter_sensor_adapters</name><version>0.1.0</version>
  <description>Image-based H-Flow, range and local TF adapters for Porter sensor modules.</description>
  <maintainer email="petayyyy@gmail.com">sverk</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend><exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend><exec_depend>cv_bridge</exec_depend>
  <exec_depend>porter_sensor_msgs</exec_depend><exec_depend>tf2_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend><exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>launch</exec_depend><exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend><exec_depend>python3-opencv</exec_depend>
  <exec_depend>nav_msgs</exec_depend><exec_depend>livox_avia_cloud_adapter</exec_depend>
