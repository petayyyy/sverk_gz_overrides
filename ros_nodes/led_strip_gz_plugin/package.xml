<?xml version="1.0"?>
<package format="3">
  <name>led_strip_gz_plugin</name>
  <version>0.1.0</version>
  <description>Gazebo material renderer for simulated Obrik LED strips.</description>
  <maintainer email="petayyyy@gmail.com">sverk</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>led_interfaces</depend>
  <build_depend>gz-cmake3</build_depend>
  <build_depend>gz-sim8-dev</build_depend>
  <build_depend>gz-plugin2-dev</build_depend>
  <exec_depend>gz-sim8</exec_depend>

  <export><build_type>ament_cmake</build_type></export>
</package>
