<sdf version="1.9">
  <model name="x500_obrik_one_rangefinder_battery">
    <self_collide>false</self_collide>
    <include merge="true"><uri>model://x500_obrik_one_rangefinder</uri></include>
    <link name="battery_visual_link">
      <pose relative_to="base_link">0 0 0.036 0 0 0</pose>
      <gravity>false</gravity><self_collide>false</self_collide>
