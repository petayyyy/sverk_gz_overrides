      <visual name="battery_visual"><cast_shadows>true</cast_shadows><geometry><mesh><uri>model://x500_obrik_battery/meshes/obrik_battery_28x65x22_r5.obj</uri></mesh></geometry><material><ambient>0.18 0.18 0.18 1</ambient><diffuse>0.38 0.38 0.38 1</diffuse><specular>0.04 0.04 0.04 1</specular></material></visual>
