<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <model name='x500_obrik_base'>
    <self_collide>false</self_collide>
    <!-- The obrik body visual is NOT added here: model://x500 merges
         model://x500_base, whose base_link already carries visual
         "obrik_body_visual" with meshes/obrik_base_clean.obj (82k faces,
         248 material sections). A second copy of that link/joint here used
         to render the mesh TWICE in every pass (camera sensor, lidar, GUI)
         and z-fight with itself. -->
    <include merge='true'>
      <uri>model://x500</uri>
    </include>
    <include merge='true'>
      <uri>model://rpi_camera</uri>
      <pose relative_to="base_link">0 -0.061500 0.003100 0 1.5707963 1.5707963</pose>
      <name>rpi_camera</name>
    </include>
    <joint name="CameraJoint" type="fixed">
      <parent>base_link</parent>
      <child>rpi_camera_link</child>
      <pose relative_to="base_link">0 -0.061500 0.003100 0 1.5707963 1.5707963</pose>
    </joint>
    <joint name="obrik_rangefinder_down_joint" type="fixed">
      <parent>base_link</parent>
      <child>obrik_rangefinder_down_link</child>
    </joint>
    <link name="obrik_rangefinder_down_link">
      <pose relative_to="base_link">0 0.047500 -0.009000 0 1.5707963 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>0.00001</ixx>
          <iyy>0.00001</iyy>
          <izz>0.00001</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <sensor name="obrik_rangefinder_down" type="gpu_lidar">
        <pose>0 0 0 0 0 0</pose>
        <!-- gpu_lidar is a RENDER sensor: even 1x1 samples force a render pass
             per update. 20 Hz is plenty for EKF2 range fusion and cuts
             render-thread wakeups by 60% vs the old 50 Hz. -->
        <update_rate>20</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.03</min>
            <max>4.0</max>
            <resolution>0.001</resolution>
          </range>
        </ray>
        <always_on>1</always_on>
        <visualize>false</visualize>
      </sensor>
    </link>
    <!-- BEGIN generated Obrik LED point preview from C:/Users/evk41/Documents/leds.dxf -->
    <link name="obrik_led_points_link">
      <pose relative_to="base_link">0 0 0 0 0 0</pose>
      <gravity>false</gravity>
      <self_collide>false</self_collide>
      <inertial>
        <mass>0.00001</mass>
        <inertia>
          <ixx>1e-9</ixx>
          <iyy>1e-9</iyy>
          <izz>1e-9</izz>
        </inertia>
      </inertial>
