<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.9">
  <model name="firefighter_P4_n6_camera">
    <static>false</static>
    <self_collide>false</self_collide>
    <link name="firefighter_P4_n6_camera_link">
      <sensor name="firefighter_P4_n6_camera_imager" type="camera">
        <pose relative_to="firefighter_P4_n6_camera_sensing">0 0 0 0 0 0</pose>
        <topic>/firefighter_P4/n6/image</topic>
        <always_on>false</always_on>
