          <noise>
            <type>gaussian</type>
            <mean>0</mean>
            <stddev>0.005</stddev>
          </noise>
        </camera>
      </sensor>
      <inertial>
        <pose>0.009724 0.017807 0.022535 0 0 0</pose>
        <mass>0.08</mass>
        <inertia>
          <ixx>2.21120947733333e-05</ixx>
          <iyy>2.44532855733333e-05</iyy>
          <izz>1.94813150133333e-05</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="housing_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://firefighter_P4_n6_camera/meshes/sensor.obj</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
      </visual>
      <collision name="housing_collision">
        <pose>0.009724 0.017807 0.022535 0 -0 1.5707963267949</pose>
        <geometry>
          <box>
            <size>0.036854 0.041456 0.04607</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.8</mu>
              <mu2>0.8</mu2>
            </ode>
          </friction>
