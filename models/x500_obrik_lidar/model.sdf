<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <model name='x500_obrik_lidar'>
    <self_collide>false</self_collide>
    <include merge='true'>
      <uri>model://x500</uri>
    </include>
    <link name="obrik_body_visual_link">
      <pose relative_to="base_link">0 0 0 0 0 0</pose>
      <gravity>false</gravity>
      <self_collide>false</self_collide>
      <inertial>
        <mass>0.00001</mass>
        <inertia>
          <ixx>1e-9</ixx>
          <iyy>1e-9</iyy>
          <izz>1e-9</izz>
        </inertia>
      </inertial>
      <visual name="obrik_body_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://x500_obrik_lidar/meshes/obrik_lidar_clean.obj</uri>
          </mesh>
        </geometry>
      </visual>
    </link>
    <joint name="obrik_body_visual_joint" type="fixed">
      <parent>base_link</parent>
      <child>obrik_body_visual_link</child>
    </joint>
    <include merge='true'>
      <uri>model://rpi_camera</uri>
      <pose relative_to="base_link">0 -0.061500 0.003100 0 1.5707963 1.5707963</pose>
      <name>rpi_camera</name>
    </include>
    <joint name="CameraJoint" type="fixed">
      <parent>base_link</parent>
      <child>rpi_camera_link</child>
      <pose relative_to="base_link">0 -0.061500 0.003100 0 1.5707963 1.5707963</pose>
    </joint>
    <joint name="obrik_rangefinder_down_joint" type="fixed">
      <parent>base_link</parent>
      <child>obrik_rangefinder_down_link</child>
    </joint>
    <link name="obrik_rangefinder_down_link">
      <pose relative_to="base_link">0 0.047500 -0.009000 0 1.5707963 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>0.00001</ixx>
          <iyy>0.00001</iyy>
          <izz>0.00001</izz>
        </inertia>
      </inertial>
      <sensor name="obrik_rangefinder_down" type="gpu_lidar">
        <pose>0 0 0 0 0 0</pose>
        <update_rate>50</update_rate>
        <ray>
          <scan>
            <horizontal><samples>1</samples><resolution>1</resolution><min_angle>0</min_angle><max_angle>0</max_angle></horizontal>
            <vertical><samples>1</samples><resolution>1</resolution><min_angle>0</min_angle><max_angle>0</max_angle></vertical>
          </scan>
          <range><min>0.03</min><max>4.0</max><resolution>0.001</resolution></range>
        </ray>
        <always_on>1</always_on>
        <visualize>false</visualize>
      </sensor>
    </link>
    <joint name="obrik_lidar_joint" type="fixed">
      <parent>base_link</parent>
      <child>obrik_lidar_link</child>
    </joint>
    <link name="obrik_lidar_link">
      <pose relative_to="base_link">0 -0.051500 0.026600 0 0 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>0.00001</ixx>
          <iyy>0.00001</iyy>
          <izz>0.00001</izz>
        </inertia>
      </inertial>
      <visual name="obrik_lidar_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://x500_obrik_lidar/meshes/ld19.obj</uri>
          </mesh>
        </geometry>
      </visual>
      <sensor name="obrik_lidar" type="gpu_lidar">
        <pose>0 0 0 0 0 0</pose>
        <update_rate>10</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>720</samples>
              <resolution>1</resolution>
              <min_angle>-3.1415926</min_angle>
              <max_angle>3.1415926</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.02</min>
            <max>12.0</max>
            <resolution>0.001</resolution>
          </range>
        </ray>
        <always_on>1</always_on>
        <visualize>true</visualize>
      </sensor>
    </link>
  </model>
</sdf>
