        <always_on>false</always_on>
        <update_rate>20</update_rate>
        <visualize>false</visualize>
        <lidar>
          <scan>
            <horizontal>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>-0.000000000000</min_angle>
              <max_angle>0.000000000000</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>-0.000000000000</min_angle>
              <max_angle>0.000000000000</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.1</min>
            <max>200.0</max>
            <resolution>0.001</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0</mean>
            <stddev>0.05</stddev>
          </noise>
        </lidar>
      </sensor>
      <inertial>
        <pose>0.025 0 0 0 0 0</pose>
        <mass>0.12</mass>
        <inertia>
          <ixx>4.0326409e-05</ixx>
          <iyy>3.4e-05</iyy>
          <izz>5.6326409e-05</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="housing_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://firefighter_P4_rangefinder_200m/meshes/sensor.obj</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
      </visual>
      <collision name="housing_collision">
        <pose>0.025 0 0 1.5707963267949 -0 1.5707963267949</pose>
        <geometry>
          <box>
            <size>0.05697 0.031 0.051</size>
          </box>
        </geometry>
        <surface>
