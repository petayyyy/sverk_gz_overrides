<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.9">
  <model name="firefighter_P4_rangefinder_200m">
    <static>false</static>
    <self_collide>false</self_collide>
    <link name="firefighter_P4_rangefinder_200m_link">
      <sensor name="firefighter_P4_rangefinder_200m_range" type="gpu_lidar">
        <pose relative_to="firefighter_P4_rangefinder_200m_sensing">0 0 0 0 0 0</pose>
        <topic>/firefighter_P4/rangefinder_200m/scan</topic>
