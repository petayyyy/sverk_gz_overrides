<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <model name="brio_95_camera">
    <self_collide>false</self_collide>
    <static>false</static>

    <link name="brio_95_camera_link">
      <!-- Logitech specifies 75 g excluding the attached USB cable. Keep the
           simulated module effectively massless for now so adding it does not
           perturb the tuned Gigaobrik flight physics. The visual has no
           collision because it is a payload sensor module. -->
      <inertial>
        <mass>0.000001</mass>
        <inertia>
          <ixx>0.00005</ixx>
          <iyy>0.00005</iyy>
          <izz>0.00005</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <visual name="brio_95_visual">
        <!-- Supplied mesh is already in metres and uses Gazebo camera
             convention: link-local +X is forward / the optical axis, +Z up. -->
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://brio_95_camera/meshes/brio_95_camera.obj</uri>
          </mesh>
        </geometry>
      </visual>

      <sensor name="imager" type="camera">
        <!-- The CAD datum is not the lens centre. The supplied optical-ray
             origin is 25.6 mm forward and 15.10 mm to link-local +Y. -->
        <pose>0.0256 0.01510 0 0 0 0</pose>
        <camera>
          <!-- Logitech BRIO 95: 1920x1080 at 30 fps, fixed focus, 58 degree
               diagonal FoV. Gazebo requires horizontal FoV: converting the
               58 degree diagonal FoV for a 16:9 image gives 51.572440 deg
               (0.900108877927 rad); the corresponding vertical FoV is
               30.406643 deg. -->
          <horizontal_fov>0.900108877927</horizontal_fov>
          <image>
            <width>1920</width>
            <height>1080</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <!-- Deliberately use a 20 mm geometric near plane, rather than
                 deriving it from the real camera's optics. This is below the
                 mounted lens's 24.475 mm floor clearance, so it can see the
                 marker directly beneath the vehicle. -->
            <near>0.020</near>
            <far>50</far>
          </clip>
        </camera>
        <!-- Render only when a Gazebo or ROS subscriber selects this camera. -->
        <always_on>false</always_on>
        <update_rate>30</update_rate>
        <visualize>false</visualize>
      </sensor>
    </link>
  </model>
</sdf>
