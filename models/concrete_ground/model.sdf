<?xml version="1.0"?>
<sdf version="1.9">
  <model name="concrete_ground">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>1 1</size>
          </plane>
        </geometry>
        <surface>
          <friction><ode/></friction>
          <bounce/>
          <contact/>
        </surface>
      </collision>
      <visual name="visual">
        <cast_shadows>false</cast_shadows>
        <geometry>
          <mesh>
            <uri>model://concrete_ground/meshes/concrete_ground.obj</uri>
          </mesh>
        </geometry>
      </visual>
    </link>
  </model>
</sdf>
