<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <model name='x500_obrik_gigaobrik'>
    <include merge='true'>
      <uri>model://x500_obrik_gigaobrik_base</uri>
    </include>
    <!-- Reusable MTF-01 body and sensing stack. Its normalized local +X
         sensing axis uses the RPi-style downward-facing mount while preserving
         the measured body-frame origin: (0, 84.5, -5.801) mm. -->
    <include merge="true">
      <uri>model://mtf01</uri>
      <pose relative_to="base_link">0 0.084500 -0.005801 0 1.5707963267948966 1.5707963267948966</pose>
    </include>
    <joint name="mtf01_joint" type="fixed">
      <parent>base_link</parent>
      <child>mtf01_link</child>
    </joint>
    <!-- Front Orange Pi camera. Its normalized model-local +X optical axis
         is yawed toward body +Y. -->
    <include>
      <uri>model://orange_pi_camera</uri>
      <name>orange_pi_camera_front</name>
      <pose relative_to="base_link">0 0.113885 0.023131 0 0 1.5707963267948966</pose>
    </include>
    <joint name="orange_pi_camera_front_joint" type="fixed">
      <parent>base_link</parent>
      <child>orange_pi_camera_front::orange_pi_camera_link</child>
    </joint>
    <!-- Bottom Orange Pi camera. The normalized model-local +X optical axis
         uses the same downward-facing mounting convention as the RPi camera. -->
    <include>
      <uri>model://orange_pi_camera</uri>
      <name>orange_pi_camera_bottom</name>
      <pose relative_to="base_link">0 0.067001 -0.004800 0 1.5707963267948966 1.5707963267948966</pose>
    </include>
    <joint name="orange_pi_camera_bottom_joint" type="fixed">
      <parent>base_link</parent>
      <child>orange_pi_camera_bottom::orange_pi_camera_link</child>
    </joint>
    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_0_joint</jointName>
      <linkName>rotor_0</linkName>
      <turningDirection>ccw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>1000.0</maxRotVelocity>
      <motorConstant>8.37e-07</motorConstant>
      <momentConstant>0.0035</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>0</motorNumber>
      <rotorDragCoefficient>7.9e-06</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-07</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>
    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_1_joint</jointName>
      <linkName>rotor_1</linkName>
      <turningDirection>ccw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>1000.0</maxRotVelocity>
      <motorConstant>8.37e-07</motorConstant>
      <momentConstant>0.0035</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>1</motorNumber>
      <rotorDragCoefficient>7.9e-06</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-07</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>
    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_2_joint</jointName>
      <linkName>rotor_2</linkName>
      <turningDirection>cw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>1000.0</maxRotVelocity>
      <motorConstant>8.37e-07</motorConstant>
      <momentConstant>0.0035</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>2</motorNumber>
      <rotorDragCoefficient>7.9e-06</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-07</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>
    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_3_joint</jointName>
      <linkName>rotor_3</linkName>
      <turningDirection>cw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>1000.0</maxRotVelocity>
      <motorConstant>8.37e-07</motorConstant>
      <momentConstant>0.0035</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>3</motorNumber>
      <rotorDragCoefficient>7.9e-06</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-07</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>
  </model>
</sdf>
