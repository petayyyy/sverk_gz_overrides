<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.9">
  <model name="firefighter_P4_blackfly_camera">
    <static>false</static>
    <self_collide>false</self_collide>
    <link name="firefighter_P4_blackfly_camera_link">
      <sensor name="imager" type="camera">
        <pose relative_to="firefighter_P4_blackfly_camera_sensing">0 0 0 0 0 0</pose>
        <always_on>false</always_on>
        <update_rate>24</update_rate>
        <visualize>false</visualize>
        <camera>
          <horizontal_fov>1.0471975511965976</horizontal_fov>
          <image>
            <width>2448</width>
