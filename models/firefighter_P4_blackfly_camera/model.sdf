            <stddev>0.004</stddev>
          </noise>
          <camera_info_topic>/firefighter_P4/blackfly/camera_info</camera_info_topic>
        </camera>
        <topic>/firefighter_P4/blackfly/image</topic>
      </sensor>
      <inertial>
        <pose>0.031882 0 0 0 0 0</pose>
        <mass>0.15</mass>
        <inertia>
          <ixx>4.411892305e-05</ixx>
          <iyy>0.00017333991805</iyy>
          <izz>0.000173279005</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="housing_visual">
