<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <model name="foxeer_t_rex_mini_camera">
    <self_collide>false</self_collide>
    <static>false</static>

    <link name="foxeer_t_rex_mini_link">
      <!-- Foxeer specifies 10.2 g without the cable. Keep the included sensor
           effectively massless, consistently with the other Firefighter
           payload models, so it does not retune the X500 flight dynamics. -->
      <inertial>
        <mass>0.000001</mass>
        <inertia>
          <ixx>1e-12</ixx>
          <iyy>1e-12</iyy>
          <izz>1e-12</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <visual name="foxeer_t_rex_mini_visual">
        <!-- The STEP/OBJ lens axis is local +Z. Normalize the reusable model
             to Gazebo's camera convention, where link-local +X is forward. -->
        <pose>0 0 0 0 1.5707963267948966 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://foxeer_t_rex_mini_camera/meshes/foxeer_t_rex_mini.obj</uri>
          </mesh>
        </geometry>
      </visual>

      <sensor name="imager" type="camera">
        <!-- The lens shoulder is 21.5 mm along mesh-local +Z, which maps to
             the normalized link's +X optical axis. -->
        <pose>0.0215 0 0 0 0 0</pose>
        <camera>
          <!-- Foxeer T-Rex Mini: 2 MP CMOS, switchable 4:3/16:9 and PAL/NTSC,
               1500 TVL, with 120 deg horizontal / 150 deg diagonal FoV in
               4:3 mode. A 640x480, 30 Hz square-pixel frame is the Gazebo
               approximation of its 4:3 NTSC CVBS feed. -->
          <horizontal_fov>2.0943951023931953</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.01</near>
            <far>50</far>
          </clip>
        </camera>
        <!-- Render only when a Gazebo or ROS subscriber requests the FPV feed. -->
        <always_on>false</always_on>
        <update_rate>30</update_rate>
        <visualize>false</visualize>
      </sensor>
    </link>
  </model>
</sdf>
