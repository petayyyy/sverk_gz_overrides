<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <model name='x500_obrik_graffiti'>
    <include merge='true'>
      <uri>model://x500_obrik_graffiti_base</uri>
    </include>
        <include merge='true'>
      <uri>model://rpi_camera</uri>
      <pose relative_to="base_link">0 -0.044845 -0.099000 0 1.5707963 1.5707963</pose>
      <name>rpi_camera</name>
    </include>
    <joint name="CameraJoint" type="fixed">
      <parent>base_link</parent>
      <child>rpi_camera_link</child>
      <pose relative_to="base_link">0 -0.044845 -0.099000 0 1.5707963 1.5707963</pose>
    </joint>
    <joint name="obrik_rangefinder_down_joint" type="fixed">
      <parent>base_link</parent>
      <child>obrik_rangefinder_down_link</child>
    </joint>
    <link name="obrik_rangefinder_down_link">
      <pose relative_to="base_link">0 -0.025000 -0.099000 0 1.5707963 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>0.00001</ixx>
          <iyy>0.00001</iyy>
          <izz>0.00001</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <sensor name="obrik_rangefinder_down" type="gpu_lidar">
        <pose>0 0 0 0 0 0</pose>
        <update_rate>50</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.03</min>
            <max>4.0</max>
            <resolution>0.001</resolution>
          </range>
        </ray>
        <always_on>1</always_on>
        <visualize>false</visualize>
      </sensor>
    </link>
    <link name="spray_nozzle_link">
      <pose relative_to="base_link">0 0.167000 0 0 0 1.5707963</pose>
      <gravity>false</gravity>
      <self_collide>false</self_collide>
      <inertial>
        <mass>0.0001</mass>
        <inertia>
          <ixx>1e-9</ixx>
          <iyy>1e-9</iyy>
          <izz>1e-9</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
    </link>
    <joint name="spray_nozzle_joint" type="fixed">
      <parent>base_link</parent>
      <child>spray_nozzle_link</child>
    </joint>
    <plugin filename="libSprayPaintPlugin.so" name="gz::sim::systems::SprayPaintPlugin">
      <nozzle_link>spray_nozzle_link</nozzle_link>
      <cone_half_angle_deg>15</cone_half_angle_deg>
      <cone_max_range>1.0</cone_max_range>
      <spray_color>1.0 0.2 0.1 1.0</spray_color>
      <spray_topic>/spray</spray_topic>
      <spray_color_topic>/spray/color</spray_color_topic>
      <spray_cone_topic>/spray/cone_half_angle_deg</spray_cone_topic>
      <spray_range_topic>/spray/range</spray_range_topic>
      <spray_particle_rate_topic>/spray/particle_rate</spray_particle_rate_topic>
      <spray_num_rays_topic>/spray/num_rays</spray_num_rays_topic>
      <spray_patch_spacing_topic>/spray/patch_spacing</spray_patch_spacing_topic>
      <spray_paint_interval_steps_topic>/spray/paint_interval_steps</spray_paint_interval_steps_topic>
      <spray_enable_particle_emitter_topic>/spray/enable_particle_emitter</spray_enable_particle_emitter_topic>
      <particle_rate>100</particle_rate>
      <num_rays>16</num_rays>
      <patch_spacing>0.02</patch_spacing>
      <paint_interval_steps>10</paint_interval_steps>
      <enable_particle_emitter>true</enable_particle_emitter>
    </plugin>
    <plugin filename="libGraffitiServoKinematics.so" name="sverk::sim::GraffitiServoKinematics">
      <topic>/spray/servo/travel</topic>
      <gear_joint>gear_joint</gear_joint>
      <lever_joint>lever_joint</lever_joint>
      <cap_joint>can_cap_joint</cap_joint>
      <gear_max_rad>1.82</gear_max_rad>
      <lever_max_rad>-0.62</lever_max_rad>
      <cap_max_m>0.003</cap_max_m>
      <cap_start_travel>0.6193103797</cap_start_travel>
      <reverse_travel_fraction>0.6666666667</reverse_travel_fraction>
    </plugin>
    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_0_joint</jointName>
      <linkName>rotor_0</linkName>
      <turningDirection>ccw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>1000.0</maxRotVelocity>
      <motorConstant>8.37e-07</motorConstant>
      <momentConstant>0.0035</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>0</motorNumber>
      <rotorDragCoefficient>7.9e-06</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-07</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>
    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_1_joint</jointName>
      <linkName>rotor_1</linkName>
      <turningDirection>ccw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>1000.0</maxRotVelocity>
      <motorConstant>8.37e-07</motorConstant>
      <momentConstant>0.0035</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>1</motorNumber>
      <rotorDragCoefficient>7.9e-06</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-07</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>
    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_2_joint</jointName>
      <linkName>rotor_2</linkName>
      <turningDirection>cw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>1000.0</maxRotVelocity>
      <motorConstant>8.37e-07</motorConstant>
      <momentConstant>0.0035</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>2</motorNumber>
      <rotorDragCoefficient>7.9e-06</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-07</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>
    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_3_joint</jointName>
      <linkName>rotor_3</linkName>
      <turningDirection>cw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>1000.0</maxRotVelocity>
      <motorConstant>8.37e-07</motorConstant>
      <momentConstant>0.0035</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>3</motorNumber>
      <rotorDragCoefficient>7.9e-06</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-07</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>
</model>
</sdf>
