    <!-- END generated Obrik LED point preview -->

    <plugin filename="libLedStripVisualization.so" name="sverk::sim::LedStripVisualization">
      <led_link>obrik_led_points_link</led_link>
      <visual_prefix>obrik_led_point_</visual_prefix>
      <frame_topic>/led/sim/frame</frame_topic>
      <brightness_topic>/led/sim/brightness</brightness_topic>
    </plugin>
    <plugin filename="libSprayPaintPlugin.so" name="gz::sim::systems::SprayPaintPlugin">
      <nozzle_link>spray_nozzle_link</nozzle_link>
      <cone_half_angle_deg>15</cone_half_angle_deg>
      <cone_max_range>1.0</cone_max_range>
      <spray_color>1.0 0.2 0.1 1.0</spray_color>
      <spray_topic>/spray</spray_topic>
      <spray_color_topic>/spray/color</spray_color_topic>
      <spray_cone_topic>/spray/cone_half_angle_deg</spray_cone_topic>
      <spray_range_topic>/spray/range</spray_range_topic>
      <spray_particle_rate_topic>/spray/particle_rate</spray_particle_rate_topic>
      <spray_num_rays_topic>/spray/num_rays</spray_num_rays_topic>
      <spray_patch_spacing_topic>/spray/patch_spacing</spray_patch_spacing_topic>
      <spray_paint_interval_steps_topic>/spray/paint_interval_steps</spray_paint_interval_steps_topic>
      <spray_enable_particle_emitter_topic>/spray/enable_particle_emitter</spray_enable_particle_emitter_topic>
      <particle_rate>100</particle_rate>
      <num_rays>16</num_rays>
      <patch_spacing>0.02</patch_spacing>
      <paint_interval_steps>10</paint_interval_steps>
      <enable_particle_emitter>true</enable_particle_emitter>
    </plugin>
    <plugin filename="libGraffitiServoKinematics.so" name="sverk::sim::GraffitiServoKinematics">
      <mode>simple_cam</mode>
      <topic>/spray/servo/travel</topic>
      <cam_joint>graffiti_cam_joint</cam_joint>
      <cap_joint>can_cap_joint</cap_joint>
      <cam_press_rad>-1.1609930184</cam_press_rad>
      <cap_max_m>0.003</cap_max_m>
      <reverse_travel_fraction>1.3529765484</reverse_travel_fraction>
    </plugin>
    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_0_joint</jointName><linkName>rotor_0</linkName><turningDirection>ccw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp><timeConstantDown>0.025</timeConstantDown><maxRotVelocity>1000.0</maxRotVelocity>
      <motorConstant>8.37e-07</motorConstant><momentConstant>0.0035</momentConstant><commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>0</motorNumber><rotorDragCoefficient>7.9e-06</rotorDragCoefficient><rollingMomentCoefficient>1e-07</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim><motorType>velocity</motorType>
    </plugin>
