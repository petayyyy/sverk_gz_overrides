<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <model name='x500_obrik_graffiti'>
    <self_collide>false</self_collide>
    <!-- The custom base owns the body, collision, IMU, and standard Obrik
         rotor geometry. This model adds the graffiti mechanism and sensors. -->
    <include merge='true'>
      <uri>model://x500_obrik_graffiti_cam_base</uri>
    </include>
    <include merge='true'>
      <uri>model://rpi_camera</uri>
      <pose relative_to="base_link">0 -0.061500 0.003100 0 1.5707963 1.5707963</pose>
      <name>rpi_camera</name>
    </include>
    <joint name="CameraJoint" type="fixed">
      <parent>base_link</parent>
      <child>rpi_camera_link</child>
      <pose relative_to="base_link">0 -0.061500 0.003100 0 1.5707963 1.5707963</pose>
    </joint>
    <joint name="obrik_rangefinder_down_joint" type="fixed">
      <parent>base_link</parent>
      <child>obrik_rangefinder_down_link</child>
    </joint>
    <link name="obrik_rangefinder_down_link">
      <pose relative_to="base_link">0 0.047500 -0.009000 0 1.5707963 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>0.00001</ixx>
          <iyy>0.00001</iyy>
          <izz>0.00001</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <sensor name="obrik_rangefinder_down" type="gpu_lidar">
        <pose>0 0 0 0 0 0</pose>
        <!-- gpu_lidar is a RENDER sensor: even 1x1 samples force a render pass
             per update. 20 Hz is plenty for EKF2 range fusion and cuts
             render-thread wakeups by 60% vs the old 50 Hz. -->
        <update_rate>20</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.03</min>
            <max>4.0</max>
            <resolution>0.001</resolution>
          </range>
        </ray>
        <always_on>1</always_on>
        <visualize>false</visualize>
      </sensor>
    </link>
    <link name="graffiti_cam_link">
      <pose relative_to="base_link">0 0.076450 0.054651 0 1.1609930184 0</pose>
      <gravity>false</gravity>
      <self_collide>false</self_collide>
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>1e-5</ixx>
          <iyy>1e-5</iyy>
          <izz>1e-5</izz>
        </inertia>
      </inertial>
      <visual name="graffiti_cam_visual">
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://x500_obrik_graffiti/meshes/cam.obj</uri>
          </mesh>
        </geometry>
      </visual>
    </link>
    <joint name="graffiti_cam_joint" type="revolute">
      <parent>base_link</parent>
      <child>graffiti_cam_link</child>
      <axis>
        <xyz expressed_in="base_link">0 1 0</xyz>
        <limit>
          <lower>-1.1609930184</lower>
          <upper>1.5707963268</upper>
          <effort>1</effort>
          <velocity>10</velocity>
        </limit>
        <dynamics>
          <damping>0.01</damping>
          <friction>0</friction>
        </dynamics>
      </axis>
    </joint>
    <link name="can_cap_link">
      <pose relative_to="base_link">0 0.083400 0.031900 0 0 0</pose>
      <gravity>false</gravity>
      <self_collide>false</self_collide>
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>1e-5</ixx>
          <iyy>1e-5</iyy>
          <izz>1e-5</izz>
        </inertia>
      </inertial>
      <visual name="can_cap_visual">
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://x500_obrik_graffiti/meshes/cap.obj</uri>
          </mesh>
        </geometry>
      </visual>
    </link>
    <joint name="can_cap_joint" type="prismatic">
      <parent>base_link</parent>
      <child>can_cap_link</child>
      <axis>
        <xyz expressed_in="base_link">0 0 -1</xyz>
        <limit>
          <lower>0</lower>
          <upper>0.003</upper>
          <effort>1</effort>
          <velocity>0.05</velocity>
        </limit>
        <dynamics>
          <damping>0.01</damping>
          <friction>0</friction>
        </dynamics>
      </axis>
    </joint>
    <link name="obrik_slam_rangefinder_link">
      <pose relative_to="base_link">0 0.057490 0.080600 0 0 1.5707963268</pose>
      <gravity>false</gravity>
      <self_collide>false</self_collide>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>0.00001</ixx>
          <iyy>0.00001</iyy>
          <izz>0.00001</izz>
        </inertia>
      </inertial>
      <visual name="obrik_slam_rangefinder_visual">
        <pose>0 0 0 -1.5707963268 0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://x500_obrik_graffiti/meshes/vl53l0x_PCB.obj</uri>
          </mesh>
        </geometry>
      </visual>
      <sensor name="obrik_slam_rangefinder" type="gpu_lidar">
        <pose>0 0 0 0 0 0</pose>
        <update_rate>50</update_rate>
        <ray>
          <scan>
            <horizontal><samples>1</samples><resolution>1</resolution><min_angle>0</min_angle><max_angle>0</max_angle></horizontal>
            <vertical><samples>1</samples><resolution>1</resolution><min_angle>0</min_angle><max_angle>0</max_angle></vertical>
          </scan>
          <range><min>0.03</min><max>4.0</max><resolution>0.001</resolution></range>
        </ray>
        <always_on>1</always_on>
        <visualize>true</visualize>
      </sensor>
    </link>
    <joint name="obrik_slam_rangefinder_joint" type="fixed">
      <parent>base_link</parent>
      <child>obrik_slam_rangefinder_link</child>
    </joint>
