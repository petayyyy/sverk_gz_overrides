<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <world name="obrik_aruco_graffiti_wall">
    <!-- Системные плагины gz, которые нужны PX4 SITL: без них Gazebo не поднимает
         системы IMU / AirPressure / Magnetometer / NavSat / Sensors, PX4 рапортует
         "Accel/Gyro/Baro/Compass Sensor 0 missing", EKF2 не стартует и дрон не
         армится (камера/лидар при этом работают через дефолтный server.config).
         Набор соответствует штатным мирам PX4 (default.sdf) + Magnetometer. -->
    <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system"/>
    <plugin name="gz::sim::systems::UserCommands" filename="gz-sim-user-commands-system"/>
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system"/>
    <plugin name="gz::sim::systems::Contact" filename="gz-sim-contact-system"/>
    <plugin name="gz::sim::systems::Imu" filename="gz-sim-imu-system"/>
    <plugin name="gz::sim::systems::AirPressure" filename="gz-sim-air-pressure-system"/>
    <plugin name="gz::sim::systems::Magnetometer" filename="gz-sim-magnetometer-system"/>
    <plugin name="gz::sim::systems::ApplyLinkWrench" filename="gz-sim-apply-link-wrench-system"/>
    <plugin name="gz::sim::systems::NavSat" filename="gz-sim-navsat-system"/>
    <plugin name="gz::sim::systems::Sensors" filename="gz-sim-sensors-system">
      <render_engine>ogre2</render_engine>
    </plugin>
    <physics type="dart">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
      <dart>
        <collision_detector>bullet</collision_detector>
      </dart>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <scene>
      <grid>false</grid>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <!-- Shadows off: a shadow-casting directional light forces PSSM cascade
           shadow-map renders for EVERY camera sensor frame — the dominant cost
           on software (llvmpipe) sensor rendering in SITL. All ArUco markers
           already have cast_shadows=false, and removing the drone's moving
           shadow over the map makes detection lighting MORE uniform. -->
      <shadows>false</shadows>
    </scene>
    <include><uri>model://concrete_ground</uri></include>
    <light name="sunUTC" type="directional">
      <pose>0 0 500 0 0 0</pose>
      <!-- cast_shadows off together with <scene><shadows>false</shadows> above. -->
      <cast_shadows>false</cast_shadows>
      <intensity>1.0</intensity>
      <direction>0.001 0.625 -0.78</direction>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.271 0.271 0.271 1</specular>
      <attenuation>
        <range>2000</range>
        <linear>0</linear>
        <constant>1</constant>
        <quadratic>0</quadratic>
      </attenuation>
      <spot>
        <inner_angle>0</inner_angle>
        <outer_angle>0</outer_angle>
        <falloff>0</falloff>
      </spot>
    </light>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg>8.546163739800146</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>
    <include>
      <uri>model://obrik_aruco_map_4x4</uri>
    </include>
    <!-- Painting wall aligned with the full X extent of the ArUco map.
         The near face is y=0.60: draw_sverh_wall.py keeps the drone at
         y=0.32 and targets this face with the graffiti nozzle. -->
    <model name="graffiti_paint_wall">
      <static>true</static>
      <pose>0.6734 0.65 0.80 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>3.8 0.1 1.6</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <box>
              <size>3.8 0.1 1.6</size>
            </box>
          </geometry>
          <material>
            <ambient>0.95 0.95 0.95 1</ambient>
            <diffuse>0.95 0.95 0.95 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
